BOT_TOKEN=put_your_telegram_bot_token_here

# Optional: use the GGUF file name placed in llama/models/.
LLAMA_MODEL_FILE=qwen2.5-3b-instruct-q4_k_m.gguf

# Optional CPU/speed tuning. Lower context and output reduce CPU work.
LLAMA_CONTEXT_SIZE=3072
LLAMA_THREADS=8
LLAMA_THREADS_BATCH=8
LLAMA_N_PREDICT=128
# LLM_TIMEOUT_SECONDS=310